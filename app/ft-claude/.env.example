# Copy this file to .env and fill in real values before first deploy.
# `docker compose` reads .env automatically from the project root.

POSTGRES_DB=finance
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=change_me_to_a_long_random_value

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_value
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Your public domain(s) fronted by the Cloudflare Tunnel, comma-separated.
CORS_ORIGINS=https://finance.yourdomain.tld

TZ=Asia/Kolkata

# Nightly backup retention (days) before old dumps are pruned.
BACKUP_RETENTION_DAYS=14

# Optional: an rclone remote (e.g. "gdrive:finance-backups") for offsite
# copies. Requires you to `docker compose exec backup rclone config` once
# to authenticate. Leave blank to keep backups local-disk only.
RCLONE_REMOTE=
