# Add to your EXISTING Caddyfile, then: docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# - Use `handle` (NOT `handle_path`): the app expects the /inventory prefix to be passed through.
# - The container listens on port 8000 (no host port is published).
# - Write the site address the same way as your other sites. Behind Cloudflare Tunnel that is usually
#   http://<host> so Caddy does not try to issue certificates or redirect to HTTPS.

http://home.{$DOMAIN:tinyserverlab.in} {
	handle /inventory* {
		request_body {
			max_size 25MB
		}
		reverse_proxy home-inventory:8000
	}
}
