# ---------------------------------------------------------------- database
# Existing shared PostgreSQL. Only the home_inventory database is used.
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=home_inventory
DB_USER=home_inventory_user
# openssl rand -base64 24
DB_PASSWORD=change-me-long-random
# same Docker network; use "require" if Postgres has TLS
DB_SSLMODE=disable

# Docker networks that already exist on the Pi (docker network ls)
CADDY_NETWORK=caddy
DB_NETWORK=postgres

# Used only by db/init-db.sh (docker exec into the shared Postgres container)
PG_CONTAINER=shared-postgres
PG_SUPERUSER=postgres

# ---------------------------------------------------------------- hosting
BASE_PATH=/inventory
PUBLIC_URL=https://home.tinyserverlab.in/inventory
# keep true behind HTTPS
COOKIE_SECURE=true
SESSION_DAYS=30
TZ=Asia/Kolkata

# ---------------------------------------------------------------- first admin
# Created on first start only if there are no users. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Sathya
ADMIN_PASSWORD=Change-Me-Now-123

# ---------------------------------------------------------------- uploads & OCR
MAX_UPLOAD_MB=20
ENABLE_OCR=true
# e.g. eng+tam if you add tesseract-ocr-tam to the image
OCR_LANG=eng

# ---------------------------------------------------------------- reminders
# days before expiry
REMINDER_DAYS=30,7,0
REMINDER_HOUR=9
REMINDER_MINUTE=0
EXPIRING_SOON_DAYS=30

# Email (optional) — e.g. Gmail with an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Phone push via ntfy (optional) — install the ntfy app and subscribe to the topic
NTFY_URL=
NTFY_TOKEN=

# Discord and Telegram are set up in the app: Settings → Notifications (no .env needed).
# Only for a self-hosted Telegram Bot API server:
# TELEGRAM_API_BASE=https://api.telegram.org
